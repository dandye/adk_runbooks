# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: Gemini API Key (if not using Vertex AI)
# GOOGLE_API_KEY=your-gemini-api-key

# Google SecOps (Chronicle SIEM & SOAR) Configuration
CHRONICLE_PROJECT_ID=your-gcp-project-id
CHRONICLE_CUSTOMER_ID=your-chronicle-customer-id
CHRONICLE_REGION=us
SOAR_URL=https://your-soar-instance.siemplify-soar.com
SOAR_APP_KEY=your-soar-app-key

# Google Threat Intelligence / VirusTotal
VT_APIKEY=your-virustotal-api-key

# Progressive Disclosure Mode (dual_progressive | skills_only | skill_toolset | static)
ADK_DISCLOSURE_MODE=dual_progressive
