# ==============================================================================
# Environment Configuration for adk_runbooks
# ==============================================================================

# Google Cloud & Chronicle SIEM Configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1
CHRONICLE_PROJECT_ID=your-project-id
CHRONICLE_CUSTOMER_ID=00000000-0000-0000-0000-000000000000
CHRONICLE_REGION=us

# Chronicle SOAR Configuration
SOAR_URL=https://your-soar-instance.siemplify-soar.com
SOAR_APP_KEY=00000000-0000-0000-0000-000000000000

# Google Threat Intelligence / VirusTotal
VT_APIKEY=your-virustotal-api-key

# Gemini / Vertex AI Model Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_API_KEY=your-gemini-api-key

# Detection-as-Code (DAC) Agent Configuration
# GITHUB_TOKEN=your-github-token
LOG_LEVEL=INFO
